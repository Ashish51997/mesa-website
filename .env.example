# Production login URL (set in Vercel project env as VITE_LOGIN_URL)
VITE_LOGIN_URL=https://app.mesaorigins.com/login

# Auth endpoint the login screen posts {email, password} to
VITE_AUTH_URL=/api/auth/login

# Direct APK download, offered on the login screen to Android visitors only
VITE_ANDROID_APK_URL=https://app.mesaorigins.com/downloads/mesaorigins.apk
